# =====================================================================
# LabAssist settings. Copy this file to ".env" and fill in the values.
#   copy .env.example .env        (Windows Command Prompt / PowerShell)
# Never commit .env to GitHub - it holds your API key.
# =====================================================================

# ---------------- LLM (free Google Gemini key) ----------------
# 1. Go to https://aistudio.google.com/apikey and sign in with a Google account
# 2. Click "Create API key", copy it, paste it below (no quotes, no spaces)
# Leave it EMPTY to run in Offline mode (rule-based answers, still works for the demo).
LLM_API_KEY=

# OpenAI-compatible endpoint. Default = Google Gemini.
#   Groq (free):     https://api.groq.com/openai/v1    (key from https://console.groq.com/keys)
#   Ollama (local):  http://localhost:11434/v1         (no key needed; run "ollama pull llama3.2")
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Comma-separated fallback list. If the first model fails (429 quota / 404 not found),
# LabAssist automatically tries the next one. Change these to models your key can use:
#   Groq example:   llama-3.3-70b-versatile,llama-3.1-8b-instant
#   Ollama example: llama3.2
LLM_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# Seconds to wait for each model before trying the next one
LLM_TIMEOUT=30

# ---------------- Admin ----------------
# The Helpdesk needs no sign-in (students and teachers just choose their role).
# This PIN protects the Admin Dashboard and Knowledge Base pages. Change it before real use.
ADMIN_PIN=1234

# ---------------- Notifications (optional) ----------------
# Discord channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy URL.
# Unlock requests, high/critical tickets and escalations are posted there. Leave empty to disable.
DISCORD_WEBHOOK_URL=

# ---------------- Automation (optional) ----------------
# Outgoing: every ticket event is POSTed as JSON here (e.g. an n8n / Make "Webhook" trigger,
# which can then create a Jira or ServiceNow issue). Leave empty to disable.
AUTOMATION_WEBHOOK_URL=
# Incoming: external systems must send this value in the X-Webhook-Secret header to
# POST /api/webhooks/ticket-status. Use a long random text. Empty = incoming webhooks disabled.
WEBHOOK_SECRET=

# ---------------- Jira Cloud (optional, free plan up to 10 users) ----------------
# New LabAssist tickets are also created as Jira issues. All four values are needed.
# 1. Create a free site at https://www.atlassian.com/software/jira/free and a project (e.g. key LAB)
# 2. API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Issue type in your project (Task works in the default templates)
JIRA_ISSUE_TYPE=Task
# urgent = only high/critical tickets, escalations and unlock requests; all = every ticket
JIRA_SYNC=urgent

# ---------------- Streaming ----------------
# true = answers appear while the model writes them (real streaming); false = all at once
LLM_STREAM=true

# ---------------- Abuse protection ----------------
# Maximum chat messages per user per minute
RATE_LIMIT_PER_MIN=12

# ---------------- Retrieval tuning (optional) ----------------
# A question is "relevant" to the knowledge base if EITHER score reaches its threshold.
# Tuned with: python eval/run_eval.py
VECTOR_MIN_SCORE=0.35
BM25_MIN_SCORE=5.5
